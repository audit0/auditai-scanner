{
  "ruleId": "supabase.service-role-object-access-without-tenant-scope",
  "title": "Cross-tenant select on \"invoices\" via service-role client",
  "severity": "critical",
  "minConfidence": 0.85,
  "entrypoints": ["POST /api/invoices/batch"],
  "sources": ["body:ids"],
  "sinks": ["supabase.select:public.invoices"],
  "mustMentionFiles": ["vulnerable/app/api/invoices/batch/route.ts", "vulnerable/lib/supabase.ts"],
  "mustNotFlag": ["secure/app/api/invoices/batch/route.ts"],
  "verification": { "strategy": "identity-matrix", "expectedBefore": "Bob's invoice returned to Alice", "expectedAfter": "empty list" }
}
