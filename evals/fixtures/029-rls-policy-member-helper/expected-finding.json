{
  "ruleId": "supabase.rls-policy-without-caller-predicate",
  "title": "RLS policy \"notes: account members read\" on \"notes\" does not scope rows to the caller",
  "severity": "high",
  "minConfidence": 0.85,
  "entrypoints": ["GET /api/notes/[id]"],
  "sources": ["route_param:id"],
  "sinks": ["supabase.select:public.notes"],
  "mustMentionFiles": ["vulnerable/app/api/notes/[id]/route.ts", "vulnerable/supabase/migrations/0001_init.sql"],
  "mustNotFlag": ["secure/supabase/migrations/0001_init.sql"],
  "verification": {
    "strategy": "identity-matrix",
    "expectedBefore": "HTTP 200",
    "expectedAfter": "HTTP 404"
  }
}
