{
  "ruleId": "supabase.service-role-object-access-without-tenant-scope",
  "title": "Cross-tenant invoice read via service-role client",
  "severity": "critical",
  "minConfidence": 0.85,
  "entrypoints": ["GET /api/invoices/[id]"],
  "sources": ["route.param:id"],
  "sinks": ["supabase.select:public.invoices"],
  "mustMentionFiles": ["vulnerable/app/api/invoices/[id]/route.ts", "vulnerable/lib/supabase.ts"],
  "mustNotFlag": ["secure/app/api/invoices/[id]/route.ts"],
  "verification": {
    "strategy": "identity-matrix",
    "expectedBefore": "HTTP 200",
    "expectedAfter": "HTTP 403|404"
  }
}
