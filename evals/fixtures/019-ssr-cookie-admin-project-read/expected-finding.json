{
  "ruleId": "supabase.service-role-object-access-without-tenant-scope",
  "title": "Cross-tenant select on \"projects\" via service-role client",
  "severity": "critical",
  "minConfidence": 0.85,
  "entrypoints": ["GET /api/projects/[id]"],
  "sources": ["route_param:id"],
  "sinks": ["supabase.select:public.projects"],
  "mustMentionFiles": [
    "vulnerable/app/api/projects/[id]/route.ts",
    "vulnerable/lib/supabase/admin.ts"
  ],
  "mustNotFlag": ["secure/app/api/projects/[id]/route.ts"],
  "verification": {
    "strategy": "identity-matrix",
    "expectedBefore": "HTTP 200",
    "expectedAfter": "HTTP 403|404"
  }
}
