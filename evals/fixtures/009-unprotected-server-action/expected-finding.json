{
  "ruleId": "supabase.service-role-object-access-without-tenant-scope",
  "title": "Unauthenticated delete on \"invoices\" via service-role client",
  "severity": "critical",
  "minConfidence": 0.85,
  "entrypoints": ["server action deleteInvoice"],
  "sources": ["action_arg:invoiceId"],
  "sinks": ["supabase.delete:public.invoices"],
  "mustMentionFiles": ["vulnerable/app/actions.ts", "vulnerable/lib/supabase.ts"],
  "mustNotFlag": ["secure/app/actions.ts"],
  "verification": { "strategy": "identity-matrix", "expectedBefore": "row deleted", "expectedAfter": "row intact" }
}
