{
  "ruleId": "supabase.service-role-object-access-without-tenant-scope",
  "title": "Cross-tenant delete on \"documents\" via service-role client",
  "severity": "critical",
  "minConfidence": 0.85,
  "entrypoints": ["server action deleteDocument"],
  "sources": ["action_arg:formData"],
  "sinks": ["supabase.delete:public.documents"],
  "mustMentionFiles": ["vulnerable/app/documents/actions.ts", "vulnerable/lib/supabase.ts"],
  "mustNotFlag": ["secure/app/documents/actions.ts"],
  "verification": {
    "strategy": "identity-matrix",
    "expectedBefore": "row deleted",
    "expectedAfter": "row intact"
  }
}
