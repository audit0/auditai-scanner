      "import": "./dist/index.js"
    }
  },
  "bin": {
    "auditai-scan": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@auditai/core": "*",
    "@auditai/graph": "*",
    "@auditai/parser": "*",
    "@auditai/rules": "*"
  }
}
