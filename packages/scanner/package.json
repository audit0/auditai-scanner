{
  "name": "@auditai/scanner",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source deterministic security scanner for Next.js + Supabase apps: routes, server actions, Supabase clients, queries and RLS policies",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
